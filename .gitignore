# Ignore all files in tmp/ except the directory itself

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
.venv/
venv/

# Local dev launcher runtime (logs, pids, generated configs)
.dev-runtime/

# TAK Server PKI (private keys, p12 bundles). Never commit; regenerate with
# scripts/gen-certs.sh or supply production certs out-of-band.
infra/certs/

# Personal dev-launcher config (copy from scripts/dev-launcher.example.conf)
scripts/dev-launcher.conf

# Root remote TAK certs (keep placeholder only)
config/certs/*
!config/certs/.gitkeep

# Actual remote TAK config (may contain real IPs/credentials).
# Use config/remote-tak.example.yaml as the template or run:
#   bash scripts/setup-remote-tak.sh
config/remote-tak.yaml
